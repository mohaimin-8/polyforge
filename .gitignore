.gocache/
control-plane.exe
control-plane.log
polyforge-control-plane.pid
bin/
tmp/
data/*.db
data/*.db-*
research/traces/out/
# Raw public datasets are downloaded, never committed (BurstGPT CSVs, LMSYS parquet).
research/traces/data/
# Calibration assets (llama.cpp binaries + GGUF model) are re-downloadable;
# the measurement script and its outputs are what git carries.
research/calibration/data/
__pycache__/
.pytest_cache/
# Raw result databases are archived via Zenodo (eval/scripts/archive_zenodo.py);
# git carries the run-level CSV exports, figures, and logs instead.
eval/results/*.duckdb
eval/results/*.duckdb.wal
eval/results/zenodo/
# Terraform state contains the k3s join token — never commit it.
eval/infra/terraform/.terraform/
eval/infra/terraform/*.tfstate*
eval/infra/terraform/kubeconfig.yaml

# LaTeX build artifacts (thesis report + slides); the PDFs are committed deliverables.
thesis/**/*.aux
thesis/**/*.bbl
thesis/**/*.blg
thesis/**/*.log
thesis/**/*.out
thesis/**/*.toc
thesis/**/*.lof
thesis/**/*.lot
thesis/**/*.nav
thesis/**/*.snm
thesis/**/*.fls
thesis/**/*.fdb_latexmk
*.exe
reproduce_out/
research/paper/*.aux
research/paper/*.bbl
research/paper/*.blg
research/paper/*.log
research/paper/*.out
research/paper/*.spl
research/paper/main.pdf

# ZAP scan outputs (scripts/zap-baseline.sh). Regenerable from a running
# stack; the triaged findings live in docs/SECURITY.md, not in the raw HTML.
# openapi.yaml/zap.yaml here are copies the container needs under /zap/wrk.
artifacts/zap-*.html
artifacts/zap.yaml
artifacts/openapi.yaml

# WP14: written by the harness while a load window is open (Phase 5).
.soak-running

# soak_observer.sh single-instance lock
.observer.lock

# stage_b_controls.sh single-instance lock
.controls.lock

# The evidence supplement is built by scripts/build_pages.py and deployed
# by .github/workflows/pages.yml; the generator is the artifact, not the site.
site/

# The cloudflared tunnel binary (WAVE4 free route) is downloaded, not built:
# 38 MB, re-fetchable, and it has no business in the history.
/cloudflared
# Raw databases inside evidence directories follow the same rule as the
# top-level ones: Zenodo carries them, git carries the exports and summaries.
eval/results/**/*.duckdb
eval/results/**/*.duckdb.wal
# The scratch evidence directory live sittings reuse per run (see
# RESULTS_TRACE_LIVE.md's bound on TL-H3). The per-sitting copies that git
# keeps are the named ones: *_attemptN_evidence, trace_live_evidence.
eval/results/live_soak_evidence/

# soak_observer.sh's liveness heartbeat, written where it is launched from.
.observer.heartbeat
