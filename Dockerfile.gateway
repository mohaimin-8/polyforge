# syntax=docker/dockerfile:1
# AI gateway image for the three-knob live plane (PREREG_WAVE4_LIVE_PLANE.md
# §Substrate 2-3): same multi-stage/distroless pattern as the control-plane
# image. CGO off; the SQLite driver is pure Go, so the binary is static.
#
# NOT VERIFIED LOCALLY: Docker is not installed on the development machine.
# The build is exercised by the live harness (kind load) on a Docker host.

# Base images are pinned by digest (audit 2026-09-26: floating tags could change a
# rebuilt image underneath its signature). Refresh deliberately:
#   docker buildx imagetools inspect <image:tag>  -> the index digest
FROM golang:1.25.14@sha256:699337d620559a59b4a2bb298ad59611e535d2ee755a34cf2d2a98f37578dc80 AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/ai-gateway ./cmd/ai-gateway

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/ai-gateway /ai-gateway
USER nonroot:nonroot
EXPOSE 8081
ENTRYPOINT ["/ai-gateway"]
