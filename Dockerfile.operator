# PolyForge operator image (deploy/helm/polyforge-operator, operator.image).
# Mirrors the control-plane Dockerfile's shape: static build, distroless,
# numeric nonroot (runAsNonRoot cannot verify named users — session 16d).
# Base images are pinned by digest (audit 2026-09-26: floating tags could change a
# rebuilt image underneath its signature). Refresh deliberately:
#   docker buildx imagetools inspect <image:tag>  -> the index digest
FROM golang:1.26.9@sha256:d7722066f0b60ceccb6c0643cbed1f5f9e15506ac237146c95333504d7805d89 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/operator ./cmd/operator

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/operator /operator
USER 65532:65532
ENTRYPOINT ["/operator"]
